Description: textlayout: Apply the alpha of pre-edit colors
 GtkIMContextWayland styles a pre-edit segment from its CSS node (preedit,
 with the prediction class for a text-input-v3 prediction hint) and sends
 a color with alpha below 1 as a foreground (or background) attribute
 followed by a separate alpha attribute. add_preedit_attrs() converted the
 color with alpha 1 and ignored PANGO_ATTR_FOREGROUND_ALPHA and
 PANGO_ATTR_BACKGROUND_ALPHA, so a GtkTextView drew a translucent
 pre-edit, such as an input method's predicted text, at full opacity.
 GtkText lays the attributes out with Pango directly and was not affected.
 .
 Read both alpha attributes and apply them to the segment's colors once
 the whole attribute set is known.
Author: Maxime Allanic
Forwarded: no
Last-Update: 2026-10-19
---
 gtk/gtktextlayout.c |   15 +++++++++++++++
 1 file changed, 15 insertions(+)

--- a/gtk/gtktextlayout.c
+++ b/gtk/gtktextlayout.c
@@ -1937,6 +1937,7 @@
       GSList *tmp_list;
       PangoLanguage *language;
       int start, end;
+      int fg_alpha = -1, bg_alpha = -1;
 
       pango_attr_iterator_range (iter, &start, &end);
 
@@ -2010,6 +2011,12 @@
             case PANGO_ATTR_RISE:
               appearance.rise = ((PangoAttrInt *)attr)->value;
               break;
+            case PANGO_ATTR_FOREGROUND_ALPHA:
+              fg_alpha = ((PangoAttrInt *)attr)->value;
+              break;
+            case PANGO_ATTR_BACKGROUND_ALPHA:
+              bg_alpha = ((PangoAttrInt *)attr)->value;
+              break;
 	    default:
 	      break;
 	    }
@@ -2020,6 +2027,14 @@
 
       g_slist_free (extra_attrs);
 
+      /* The alpha attributes may come before or after their color one:
+       * apply them once the color is known.
+       */
+      if (fg_alpha >= 0 && appearance.fg_rgba)
+        appearance.fg_rgba->alpha = fg_alpha / 65535.;
+      if (bg_alpha >= 0 && appearance.bg_rgba)
+        appearance.bg_rgba->alpha = bg_alpha / 65535.;
+
       insert_attr = pango_attr_font_desc_new (font_desc);
       insert_attr->start_index = start + offset;
       insert_attr->end_index = end + offset;
